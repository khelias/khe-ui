{
  "name": "@khelias/ui",
  "version": "0.3.1",
  "description": "The KHE site header with its rooms menu and theme toggle, and the site footer: CSS custom properties, HTML-string renderers, React components and framework-free theme and rooms modules.",
  "license": "MIT",
  "author": "Kaido Henrik Elias",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khelias/khe-ui.git"
  },
  "homepage": "https://github.com/khelias/khe-ui#readme",
  "bugs": "https://github.com/khelias/khe-ui/issues",
  "keywords": [
    "header",
    "footer",
    "dark-mode",
    "css-custom-properties",
    "react"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./site-header.css": "./dist/site-header.css",
    "./site-footer.css": "./dist/site-footer.css",
    "./site-header": {
      "types": "./dist/site-header.d.ts",
      "default": "./dist/site-header.js"
    },
    "./site-footer": {
      "types": "./dist/site-footer.d.ts",
      "default": "./dist/site-footer.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./rooms": {
      "types": "./dist/rooms.d.ts",
      "default": "./dist/rooms.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/site-header.css src/site-footer.css dist/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run -s typecheck && npm run -s test && npm run -s build && node scripts/check-pack.mjs",
    "prepack": "npm run -s build"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
